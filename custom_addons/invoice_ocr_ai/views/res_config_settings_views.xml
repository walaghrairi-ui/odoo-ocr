<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Parametres > Comptabilite : configuration du token Groq -->
    <record id="res_config_settings_view_form_groq" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.invoice_ocr_ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='account_vendor_bills']" position="after">
                <block title="Saisie automatique IA (Groq)" id="invoice_ocr_groq_settings">
                    <setting id="groq_api_key_setting"
                             string="Cle API Groq"
                             help="Utilisee par la saisie automatique des factures et par l'Assistant IA.">
                        <field name="groq_api_key" password="True" placeholder="gsk_..."/>
                        <div class="mt8">
                            <button name="action_test_groq_connection"
                                    type="object"
                                    string="Tester la connexion"
                                    icon="fa-plug"
                                    class="btn-link"/>
                            <a href="https://console.groq.com/keys" target="_blank" class="ms-3">
                                <i class="fa fa-external-link"/> Obtenir une cle
                            </a>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
